{
  "name": "rpmanager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:prepare:postgres": "node scripts/prepare-postgres-schema.mjs",
    "db:generate:postgres": "npm run db:prepare:postgres && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push:postgres": "npm run db:prepare:postgres && prisma db push --schema prisma/schema.postgresql.prisma",
    "postinstall": "prisma generate",
    "bot:dev": "tsx bot/src/index.ts",
    "bot:start": "node --import tsx bot/src/index.ts",
    "bot:commands": "tsx bot/src/deploy-commands.ts",
    "bot:test": "node --conditions=react-server --import tsx --test bot/src/tests/security.test.ts bot/src/tests/integration.test.ts",
    "bot:typecheck": "tsc --noEmit -p tsconfig.bot.json"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
