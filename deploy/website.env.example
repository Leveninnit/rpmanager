# Set these as Northflank secrets/environment variables for the web service.
NEXTAUTH_URL=https://your-app.northflank.app
NEXTAUTH_SECRET=replace-with-a-private-random-secret
DATABASE_URL=replace-with-the-Northflank-PostgreSQL-connection-string

# Discord OAuth2 settings from the Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot-to-website service authentication. Use the same random value in
# the bot service configuration. Generate a fresh value locally; do not commit it.
DISCORD_APPLICATION_ID=
DISCORD_BOT_SERVICE_SECRET=

NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/9Mg8Utg9KW
